Configs: {
	SoulboundConfig: {
		DisplayName: Soulbound Server Config

		Headers: {
			SharedHealthSettings: Shared Health Settings
			TetherSettings: Tether Settings
			TeleportGraceSettings: Teleport & Recall Settings
			RespawnSettings: Respawn & Safety Settings
		}

		SharedHealthEnabled: {
			Label: Shared Health Enabled
			Tooltip: When enabled, all players share one unified health bar, damage, healing, and death.
		}

		TetherEnabled: {
			Label: Tether Enabled
			Tooltip: When enabled, players cannot separate past the maximum distance.
		}

		MaxDistancePixels: {
			Label: Max Distance (Pixels)
			Tooltip: The maximum allowed distance between players (1000px is approximately one screen width).
		}

		TeleportGraceSeconds: {
			Label: Teleport Grace Duration (Seconds)
			Tooltip: When someone uses Magic Mirror, Recall Potion, or teleports, gives this many seconds before pulling the other player.
		}

		PullInvincibilitySeconds: {
			Label: Pull Invincibility (Seconds)
			Tooltip: Temporary invulnerability granted to the pulled player upon arrival so they don't immediately die.
		}

		RespawnInvincibilitySeconds: {
			Label: Respawn Invincibility (Seconds)
			Tooltip: Invulnerability grace period granted upon respawn to protect against simultaneous respawn bugs, late packets, or spawn traps.
		}
	}

	SoulboundClientConfig: {
		DisplayName: Soulbound Client Config
		Headers.VisualSettings: Visual & HUD Settings

		ShowDistanceMeter: {
			Label: Show Overhead Distance Meter
			Tooltip: Displays distance in meters above your character's head with color transitions (green -> yellow -> red) and warning signs.
		}

		ShowTeleportWarning: {
			Label: Show Teleport Warning Banner
			Tooltip: Shows a clean warning message and countdown at the top of the screen when a partner teleports away.
		}
	}
}
